# FridgePal 后端配置示例：复制为 .env 并按需修改
# 数据库：开发用 SQLite，上线前换 PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fridgepal
DATABASE_URL=sqlite:///./fridgepal.db

# LLM：mock = 本地规则解析（无需任何 Key）；deepseek = 真 LLM
LLM_MODE=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 微信（测试号阶段再填）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TOKEN=
